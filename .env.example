# Database Configuration (Defaults to Docker Compose values)
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=security_scanner

# To run locally (outside Docker) pointing to local database, uncomment below:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/security_scanner
# USE_SQLITE=false

# Authentication Configuration (Generate a strong random key for production)
SECRET_KEY=a_very_secure_random_key_value_min_32_characters

# AI Provider Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Environment Mode (development | production | staging)
ENV=development

# Password Reset Configuration
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# Email Backend ("console" for local development | "smtp" for production)
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
