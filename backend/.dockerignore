# ── backend/.dockerignore ────────────────────────────────────────────────────
# Applied when Docker builds from context ./backend (as set in docker-compose.yml).
# Keeps the backend image context small, secure, and secret-free.

# Version control & repositories
.git
.gitignore

# Environment & secrets
.env
.env.*
docker.env
docker.env.*

# Python virtual environments
.venv
venv

# User uploads & data
uploads
uploads/

# Compiled bytecode
__pycache__
*.pyc
*.pyo
*.pyd
*.pdb

# Test artefacts
tests/
.pytest_cache
*.db
test.db

# Documentation
walkthrough.md
*.md

# IDE noise
.vscode
.idea
.DS_Store
