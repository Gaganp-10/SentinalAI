# ============================================================
# docker.env.example — Docker Compose environment template
# ============================================================
# Copy this file to `docker.env` before running `docker compose up`:
#   cp docker.env.example docker.env
#
# DO NOT commit docker.env with production secrets to git.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/secdetector
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secdetector

# --- Auth ---
# Change to a strong random string (min 32 characters) for production
SECRET_KEY=dev-secret-key-change-later-for-production-min-32-chars

# --- AI Provider configuration ("template" | "groq" | "ollama" | "openai") ---
# Defaults to "template" if API keys are not supplied.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- OSV.dev SCA configuration ---
OSV_API_BASE_URL=https://api.osv.dev

# --- Upload & Scan limits ---
MAX_UPLOAD_SIZE_MB=50
MAX_MANIFEST_UPLOAD_SIZE_MB=10

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=1020864929554-v9mb9l065pedkr9ah01a1n3jsggfbc5c.apps.googleusercontent.com

# --- Environment mode (development | production | staging) ---
ENV=development

# --- Password reset ---
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Email backend ("console" for dev, "smtp" for production) ---
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
