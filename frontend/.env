# Backend API base URL
# NOTE: In development, vite.config.js proxies all /auth /projects /scans /vulnerabilities
# /reports /ai requests to http://localhost:8000, so this var is NOT used by client.js
# (client.js uses baseURL:'' to let the Vite proxy handle routing, avoiding CORS).
# This value is only relevant for production builds where nginx reverse-proxies the requests.
VITE_API_BASE_URL=http://127.0.0.1:8000
