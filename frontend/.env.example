# ==============================================================================
# SentinelAI Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# ------------------------------------------------------------------------------
# DEVELOPMENT:
# Leave VITE_API_BASE_URL empty (or commented out).
# In development mode, the app defaults API_BASE_URL to "/api", which is proxied
# by Vite's dev server to http://localhost:8000/api.
#
# PRODUCTION:
# REQUIRED. You MUST specify your deployed backend base URL.
# Example: VITE_API_BASE_URL=https://api.sentinelai.com/api
# If left empty in production, the application will throw a startup error.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=
