# =============================================================================
# SentinelAI Production Environment Configuration (.env.prod)
# Copy this file to docker.env (chmod 600) on your production server.
# NEVER commit real credentials, passwords, or secret keys to version control.
# =============================================================================

# Domain & TLS Configuration
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com
TLS_INTERNAL=
ACME_CA=

# Application Environment Mode
ENV=production

# PostgreSQL Database Configuration
POSTGRES_SERVER=db
POSTGRES_DB=security_scanner
POSTGRES_USER=sentinel
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=GENERATE_RANDOM_SECURE_PASSWORD_MIN_32_CHARS

# Application Cryptographic Secret Key (min 32 chars)
# Generate with: openssl rand -hex 32
SECRET_KEY=GENERATE_RANDOM_SECRET_KEY_MIN_32_CHARS_NEVER_USE_DEFAULT

# Google OAuth2 Authentication (Optional for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email / SMTP Configuration (Production uses 'smtp')
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI Provider Settings ("template" by default, or "groq" / "openai" / "ollama")
AI_PROVIDER=template
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_AI_EXPLANATIONS_PER_SCAN=10
MAX_DAILY_COPILOT_CHATS_PER_USER=50

# App-Level Abuse Controls & Production Access
ALLOW_SIGNUP=false
GOOGLE_AUTH_ALLOWLIST=
MAX_PROJECTS_PER_USER=50
MAX_DAILY_UPLOADS_PER_USER=100
MAX_DAILY_UPLOAD_MB_PER_USER=500
MAX_USER_STORAGE_MB=500

# Scan Controls
SCAN_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SCANS=2

# File Upload Limits
MAX_UPLOAD_SIZE_MB=2
MAX_ZIP_UPLOAD_SIZE_MB=50
MAX_MANIFEST_UPLOAD_SIZE_MB=10
MAX_ZIP_FILES=5000
MAX_ZIP_RATIO=100.0
MAX_UNCOMPRESSED_SIZE_MB=500
